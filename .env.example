# ═══════════════════════════════════════════════════════════════
#  Rey de la Chelada — Environment Variables (plantilla .env)
#  ═══════════════════════════════════════════════════════════════
#  CÓMO USAR:
#    1. Copia este archivo a `.env` (misma carpeta):
#         copy .env.example .env
#    2. Completa los campos marcados con ⚠️ (Secretos / decisión del dueño).
#    3. El resto (auto) ya tiene valores que funcionan.
#  IMPORTANTE: `.env` está en .gitignore — NUNCA lo subas a git.
#  ───────────────────────────────────────────────────────────────


# ── SERVER ──────────────────────────────────────────────────────
# Puerto del servidor. ¡NO uses 3001! (ocupado por otra app).
PORT=3002

# ⚠️ PRODUCCIÓN: PRODUCTION. En producción, sin JWT_SECRET el server NO arranca.
#       (puedes usar "development" temporalmente mientras configuras)
NODE_ENV=development

APP_NAME=Rey de la Chelada


# ── BASE DE DATOS (SQLite) ──────────────────────────────────────
# NO es Postgres. El default real es data/rey-de-la-chelada.db.
# (DB_PATH se usa en TESTS para DBs aisladas)
DB_PATH=data/rey-de-la-chelada.db


# ── AUTENTICACIÓN (⚠️ SECRETOS) ──────────────────────────────────
# ⚠️ OBLIGATORIO en producción: cifra los tokens de sesión (mín. 32 chars).
#    Genera uno nuevo en la PC oficial:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_min_32_chars

# ⚠️ Recomendado: otro secreto distinto para la sesión (48+ chars).
#    Genera igual: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_session_secret

JWT_EXPIRES_IN=24h
MESERO_PIN_LENGTH=4


# ── RATE LIMITING (ya ajustado para 19 dispositivos) ────────────
# Lecturas/polling (GET) — techo alto (6 PWAs en una IP)
API_READ_RATE_LIMIT_MAX=10000
# Escrituras (POST/PUT/PATCH/DELETE) — estricto anti-bot
API_WRITE_RATE_LIMIT_MAX=2500
# Login PIN — anti fuerza bruta (staff simultáneo)
AUTH_RATE_LIMIT_MAX=60


# ── PAGOS QR (Bolivia) — casi siempre vacío/no aplica en pruebas ──
QR_SIMPLE_API_KEY=
QR_SIMPLE_MERCHANT_ID=
BCB_API_KEY=
BANCO_BISA_CUENTA=


# ── IMPRESORA TÉRMICA ───────────────────────────────────────────
# ⚠️ Confirma el nombre exacto en Windows. VACÍO = usa la PREDETERMINADA de Windows.
#    (la delgadita XP-80C se configura como predeterminada → deja esto vacío)
PRINTER_NAME=
PRINTER_INTERFACE=usb
PRINT_COMANDA=true
PRINT_TICKET=true


# ── CONFIGURACIÓN DEL RESTAURANTE ───────────────────────────────
# ⚠️ NIT real del restaurante (obligatorio para tickets/facturas).
#    También lo puedes cargar en Admin → Configuración (el banner lo pide).
RESTAURANT_NIT=

RESTAURANT_IVA=13

# Mesas del salón (sin contar BARRA). Debe coincidir con capacity.totalTables (SSOT).
DEFAULT_TABLES=10
MESEROS_POR_TURNO=2


# ── RED / TAILSCALE ─────────────────────────────────────────────
# ⚠️ URL que se imprime en los QR de las mesas. DEBE ser accesible desde el
#    CELULAR del cliente (NO localhost). IP LAN o Tailscale del servidor:
#      PUBLIC_BASE_URL=http://192.168.1.50:3002        (red del local)
#      PUBLIC_BASE_URL=http://100.107.134.122:3002     (Tailscale, remoto)
#    Detecta la IP: tailscale ip -4  → 100.x.x.x  ·  Get-NetIPAddress → LAN
PUBLIC_BASE_URL=

TAILSCALE_AUTH_KEY=
NETBIRD_SETUP_KEY=


# ── GITHUB (auto-update) ────────────────────────────────────────
# ⚠️ Si llega por zip/.rar, update.bat NO funcionará (no hay git). Deja el token vacío
#    (repo público). Si clonaste con git, update.bat hace pull de main.
GITHUB_TOKEN=
GITHUB_REPO=paulogvs/rey-de-la-chelada
GITHUB_BRANCH=main


# ── FORCH.iA (ecosistema, opcional) ─────────────────────────────
FORCHI_ECOSYSTEM_PATH=D:\OTRO DISCO\FORCH-IA\FORCH-IA-ECOSYSTEM


# ── ADMIN / CONTACTO ────────────────────────────────────────────
ADMIN_EMAIL=paulo@forch-i-a.com
LEGAL_CONTACT_EMAIL=paulo@forch-i-a.com
