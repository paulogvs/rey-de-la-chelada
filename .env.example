# â”€â”€ Rey de la Chelada â€” Environment Variables â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copy this file to .env and fill in your values
# IMPORTANT: .env is in .gitignore â€” NEVER commit secrets

# Server
# NOTE: 3001 esta ocupado por otra app â€” usamos 3002
PORT=3002
NODE_ENV=development
APP_NAME=Rey de la Chelada

# Database
# SQLite (better-sqlite3) â€” NO postgres (M8/2.8: lÃ­nea DATABASE_URL eliminada).
# Default real: data/rey-de-la-chelada.db (ver server/db/index.js).
# DB_PATH se usa en TEST para DBs aisladas (p.ej. DB_PATH=data/test-e2e.db)
DB_PATH=data/rey-de-la-chelada.db

# Auth
JWT_SECRET=change_this_to_a_random_secret_min_32_chars
JWT_EXPIRES_IN=24h
MESERO_PIN_LENGTH=4
SESSION_SECRET=change_this_to_a_random_session_secret

# Rate Limiting (F1 2026-08-10)
# Lecturas/polling (GET) â€” techo alto (6 PWAs en una IP â‰ˆ 30-60 req/min)
API_READ_RATE_LIMIT_MAX=10000
# Escrituras (POST/PUT/PATCH/DELETE) â€” estricto anti-bot
API_WRITE_RATE_LIMIT_MAX=2500
# Login PIN â€” anti brute-force
AUTH_RATE_LIMIT_MAX=60

# Payment (QR Bolivia)
QR_SIMPLE_API_KEY=
QR_SIMPLE_MERCHANT_ID=
BCB_API_KEY=
BANCO_BISA_CUENTA=

# Printer (thermal)
PRINTER_NAME=XP-80C
PRINTER_INTERFACE=usb
PRINT_COMANDA=true
PRINT_TICKET=true

# Restaurant Config
RESTAURANT_NIT=
RESTAURANT_IVA=13
DEFAULT_TABLES=10
MESEROS_POR_TURNO=2

# Network
TAILSCALE_AUTH_KEY=
NETBIRD_SETUP_KEY=

# Public base URL for QR links (clientes PWA)
# IMPORTANT: la URL impresa en los QR debe ser accesible desde el CELULAR del cliente,
# NO desde el localhost de la caja. Pon la IP LAN o Tailscale del servidor, p.ej.:
#   PUBLIC_BASE_URL=http://192.168.1.50:3002
#   PUBLIC_BASE_URL=https://mi-tienda.tailscale.ts.net
# Si se deja vacÃ­o, se usa el Host del request (funciona solo si el admin abre el QR
# desde el MISMO dispositivo/red donde estarÃ¡ el cliente).

# GitHub (for auto-update)
GITHUB_TOKEN=
GITHUB_REPO=paulogvs/rey-de-la-chelada
GITHUB_BRANCH=main

# FORCH.iA
FORCHI_ECOSYSTEM_PATH=D:\OTRO DISCO\FORCH-IA\FORCH-IA-ECOSYSTEM

# Admin
ADMIN_EMAIL=paulo@forch-i-a.com
LEGAL_CONTACT_EMAIL=paulo@forch-i-a.com
