# ── Rey de la Chelada — Environment Variables ───────────────
# Copy this file to .env and fill in your values
# IMPORTANT: .env is in .gitignore — NEVER commit secrets

# Server
PORT=3001
NODE_ENV=development
APP_NAME=Rey de la Chelada

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/rey_de_la_chelada

# Auth
JWT_SECRET=change_this_to_a_random_secret_min_32_chars
JWT_EXPIRES_IN=24h
MESERO_PIN_LENGTH=4
SESSION_SECRET=change_this_to_a_random_session_secret

# Payment (QR Bolivia)
QR_SIMPLE_API_KEY=
QR_SIMPLE_MERCHANT_ID=
BCB_API_KEY=
BANCO_BISA_CUENTA=

# Printer (thermal)
PRINTER_NAME=XP-80C
PRINTER_INTERFACE=usb
PRINT_COMANDA=true
PRINT_TICKET=true

# Restaurant Config
RESTAURANT_NIT=
RESTAURANT_IVA=13
DEFAULT_TABLES=10
MESEROS_POR_TURNO=2

# Network
TAILSCALE_AUTH_KEY=
NETBIRD_SETUP_KEY=

# GitHub (for auto-update)
GITHUB_TOKEN=
GITHUB_REPO=paulogvs/rey-de-la-chelada
GITHUB_BRANCH=main

# FORCH.iA
FORCHI_ECOSYSTEM_PATH=D:\OTRO DISCO\FORCH-IA\FORCH-IA-ECOSYSTEM

# Admin
ADMIN_EMAIL=paulo@forch-i-a.com
LEGAL_CONTACT_EMAIL=paulo@forch-i-a.com
