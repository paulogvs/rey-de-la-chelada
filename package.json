{
  "name": "rey-de-la-chelada",
  "version": "1.0.0",
  "private": true,
  "description": "Rey de la Chelada — Sistema de gestion para Restaurante/Bar en Cochabamba, Bolivia",
  "author": "Paulo Velasco <paulo@forch-i-a.com> (https://github.com/paulogvs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulogvs/rey-de-la-chelada.git"
  },
  "homepage": "https://github.com/paulogvs/rey-de-la-chelada",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop rey-de-la-chelada",
    "pm2:restart": "pm2 restart rey-de-la-chelada",
    "pm2:logs": "pm2 logs rey-de-la-chelada",
    "pm2:monit": "pm2 monit",
    "setup": "setup.bat",
    "update": "update.bat",
    "backup": "backup.bat"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^4.4.0",
    "esc-pos-printer": "^1.0.11",
    "express": "5.0.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.0.0",
    "idb": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "uuid": "^11.0.0",
    "ws": "^8.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-window": "^7.0.0"
  }
}
